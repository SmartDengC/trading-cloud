TRADING_DATABASE_URL=postgresql+psycopg://trading:URL_ENCODED_POSTGRES_PASSWORD@TENCENT_PUBLIC_IP:5432/trading?sslmode=disable
# Frontend server public origin. Replace FRONTEND_PUBLIC_IP with the actual IP.
# For a temporary HTTP IP deployment, keep SESSION_SECURE=false. Switch to the
# HTTPS frontend domain and true after TLS is enabled on the frontend server.
TRADING_FRONTEND_ORIGINS=http://FRONTEND_PUBLIC_IP:8090
TRADING_PUBLIC_BASE_URL=http://FRONTEND_PUBLIC_IP:8090
TRADING_API_DOMAIN=hahadeng.cn

TRADING_ADMIN_USERNAME=admin
TRADING_ADMIN_PASSWORD_HASH=
TRADING_SESSION_COOKIE=trading_session
TRADING_SESSION_COOKIE_DOMAIN=
TRADING_SESSION_SECURE=false

TRADING_MINIO_ENDPOINT=TENCENT_PUBLIC_IP:9000
TRADING_MINIO_ACCESS_KEY=replace-with-existing-minio-app-user
TRADING_MINIO_SECRET_KEY=replace-with-existing-minio-app-password
TRADING_MINIO_BUCKET=trading-attachments
TRADING_MINIO_SECURE=false

UV_DEFAULT_INDEX=https://pypi.org/simple
