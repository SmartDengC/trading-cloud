TRADING_DATABASE_URL=postgresql+psycopg://trading:change-me@postgres:5432/trading
TRADING_FRONTEND_ORIGIN=https://app.example.com
TRADING_PUBLIC_BASE_URL=https://api.example.com
TRADING_API_DOMAIN=api.example.com

TRADING_ADMIN_USERNAME=admin
# Generate inside the API image; see README.md.
TRADING_ADMIN_PASSWORD_HASH=
TRADING_SESSION_COOKIE=trading_session
TRADING_SESSION_COOKIE_DOMAIN=
TRADING_SESSION_SECURE=true

TRADING_MINIO_ENDPOINT=minio:9000
TRADING_MINIO_ACCESS_KEY=trading-minio
TRADING_MINIO_SECRET_KEY=change-me-minio-secret
TRADING_MINIO_BUCKET=trading-attachments
TRADING_MINIO_SECURE=false

POSTGRES_DB=trading
POSTGRES_USER=trading
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=trading-minio
MINIO_ROOT_PASSWORD=change-me-minio-secret

# Legacy migration only
LEGACY_DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Host directory used by scripts/backup.sh
TRADING_BACKUP_DIR=./backups
TRADING_BACKUP_RETENTION_DAYS=14
